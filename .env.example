# Backend port for the Express server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bmprinting
MONGODB_DB_NAME=bmprinting
# One-time migration tool only. Keep both values out of Git and Vercel.
# LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/bmprinting
# ATLAS_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/bmprinting
# MIGRATION_DB_NAME=bmprinting
# MIGRATION_WRITE_APPROVAL=never-set-this-for-a-dry-run
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Comma-separated exact browser origins accepted by the API. Required in production.
# Include every local Vite port you actually use (3000-3002 are common fallbacks
# when another app occupies an earlier port).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Leave empty when frontend and API share one Vercel project/origin.
# On static hosts (e.g. GitHub Pages) set this to the deployed backend's
# HTTPS origin, and list that host's frontend origin in FRONTEND_ORIGINS.
VITE_API_BASE_URL=
# Vercel uses /. Use /BM-Printing-Services/ only on the legacy sub-path host.
VITE_BASE_PATH=/

# JWT Authentication (change JWT_SECRET in production!)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# Default admin account (only used during initial seed)
ADMIN_EMAIL=admin@bm.com
ADMIN_PASSWORD=admin123

# Supabase customer authentication (same project as the frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Google sign-in runs through Supabase Auth (Authentication > Providers > Google).
# Manual dashboard steps (no secret belongs in this file):
#   1. Google Cloud Console > Credentials > Create OAuth client ID (Web):
#      Authorized JavaScript origins = your site origins, e.g. http://localhost:3000
#      and each deployed frontend origin. Authorized redirect URI =
#      https://YOUR_PROJECT.supabase.co/auth/v1/callback
#   2. Supabase Dashboard > Authentication > Providers > Google: enable it and
#      paste the Google Client ID + Client Secret.
#   3. Supabase Dashboard > Authentication > URL Configuration: add every site
#      origin to the Redirect URLs allow list.
# The Google button is hidden until VITE_SUPABASE_URL/ANON_KEY are real values.
# Optional server-only aliases: SUPABASE_URL and SUPABASE_ANON_KEY.
# Real orders require persistent MongoDB. Never enable this for real customer orders.
ALLOW_IN_MEMORY_DB=false
# Local legacy bootstrap only. Keep false when restoring an existing database;
# startup must not create or reset authentication accounts implicitly.
SEED_DEFAULT_ADMIN=false

# Temporary compatibility for the pre-existing MongoDB Admin account.
# Set false after migrating the Admin to Supabase. If temporarily true in a
# deployment, also set LEGACY_ADMIN_AUTH_APPROVED=true after explicit review.
ALLOW_LEGACY_AUTH=true
LEGACY_ADMIN_AUTH_APPROVED=false
# Customer registration must remain on Supabase in production.
ALLOW_LEGACY_REGISTRATION=false
# Role assignment script only: supply SUPABASE_SERVICE_ROLE_KEY in a trusted
# administrator terminal environment. Never prefix this secret with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Cloudflare Turnstile. VITE_TURNSTILE_SITE_KEY is public by design; the secret
# stays server-side and is never prefixed with VITE_.
VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
TURNSTILE_SECRET_KEY=your_server_only_turnstile_secret
# Comma-separated hostnames only (no scheme, port, or path). Required in production.
TURNSTILE_HOSTNAMES=your-project.vercel.app
# Optional local development only. Production ignores these switches and
# continues to require the configured production widget credentials.
VITE_TURNSTILE_USE_TEST_KEYS=false
TURNSTILE_USE_TEST_KEYS=false

# Phone / SMS OTP authentication uses Supabase Phone Auth (GoTrue).
# No SMS secret belongs in this file or in any VITE_ variable: the SMS provider
# credentials (Twilio, Semaphore, MessageBird, Vonage, etc.) are configured in
# the Supabase Dashboard under Authentication > Providers > Phone, and Supabase
# generates, expires and verifies every OTP server-side.
# Manual dashboard steps are documented in PHONE_OTP_AUTH.md.

# Optional local development launcher settings (server only).
# MONGOD_BINARY=C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe
# MONGODB_DATA_DIR=C:/your-existing-mongodb-data-directory
# ORDER_UPLOAD_DIR and ORDER_REPORTS_DIR optionally override local artifact directories.

# Planned private object storage (not active until the storage migration is approved).
# SUPABASE_STORAGE_BUCKET=private-order-files
